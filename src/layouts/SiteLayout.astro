---
import Contact from '../components/Contact.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../data/site';
import { otherLang, type Lang } from '../i18n';
import { href, type Route } from '../i18n/routes';
import { useUi } from '../i18n/ui';
import Base from './Base.astro';

interface Props {
  lang: Lang;
  route: Route;
  /** Titre de la page, sans le nom du site. Absent sur l'accueil. */
  title?: string;
  description?: string;
}

const { lang, route, title, description = site.description[lang] } = Astro.props;
const ui = useUi(lang);
const alternates = {
  fr: href('fr', route.section, route.id),
  en: href('en', route.section, route.id),
};
---
<Base lang={lang} title={title ? `${title} — ${site.name}` : site.title} description={description} alternates={alternates}>
  <div class="layout">
    <Sidebar lang={lang} current={route.section} alternate={alternates[otherLang(lang)]} />

    <main class="content">
      <div class="content-inner">
        <slot />

        <section id="contact">
          <Contact lang={lang} />
        </section>

        <footer>© {new Date().getFullYear()} {site.name} · {ui.footer}</footer>
      </div>
    </main>
  </div>
</Base>
