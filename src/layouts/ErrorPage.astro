---
import '../styles/tokens.css';
import Head from '../components/Head.astro';
import PixelCode from '../components/PixelCode.astro';
import { site, url } from '../data/site';
import type { Variant } from '../lib/pixel-code';

type Action = 'home' | 'projects' | 'contact' | 'retry';

interface Props {
  code: string;
  title: string;
  message: string;
  variant: Variant;
  /** Le premier bouton est plein, le second en contour. */
  actions: [Action, Action];
  /** Affiche l'adresse demandée sous le message (404). */
  showPath?: boolean;
}

const { code, title, message, variant, actions, showPath = false } = Astro.props;

const ICONS: Record<Action, string> = {
  home: '<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/>',
  projects: '<rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/>',
  contact: '<rect x="3" y="5" width="18" height="14"/><path d="M3 6l9 7 9-7"/>',
  retry: '<path d="M20 12a8 8 0 1 1-2.4-5.7M20 4v5h-5"/>',
};

const LINKS: Record<Exclude<Action, 'retry'>, { label: string; href: string }> = {
  home: { label: "Retour à l'accueil", href: url() },
  projects: { label: 'Voir les projets', href: url('#projets') },
  contact: { label: 'Me contacter', href: `mailto:${site.email}` },
};

const host = Astro.site?.host ?? 'victorjost.github.io';
---
<!doctype html>
<html lang="fr">
  <head>
    <Head title={`${code} — ${title} | ${site.name}`}>
      <meta name="robots" content="noindex" />
    </Head>
  </head>
  <body>
    <header class="top">
      <a class="logo" href={url()}><span class="logo-mark" aria-hidden="true">VJ</span>{site.name}</a>
    </header>

    <main>
      <PixelCode code={code} variant={variant} />
      <div class="copy">
        <span class="code">Erreur {code}</span>
        <h1>{title}</h1>
        <p>{message}</p>
        {showPath && <code class="path" data-path hidden></code>}
        <div class="actions">
          {actions.map((action, i) => {
            const cls = i === 0 ? 'btn' : 'btn ghost';
            const icon = <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true" set:html={ICONS[action]} />;
            return action === 'retry'
              ? <button type="button" class={cls} data-retry>{icon}Réessayer</button>
              : <a class={cls} href={LINKS[action].href}>{icon}{LINKS[action].label}</a>;
          })}
        </div>
      </div>
    </main>

    <footer>
      <span>Erreur {code} sur {host}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root { --cell: 24px; } /* une case de la grille = un pixel du chiffre */
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; font: 400 16px/24px var(--font-sans); color: var(--ink);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: var(--cell) var(--cell);
    display: flex; flex-direction: column; min-height: 100vh;
  }
  a { color: var(--brand); }
  :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  @media (max-width: 560px) { :root { --cell: 16px; } }
</style>

<style>
  /* Barre du haut : la même identité que le site */
  .top { height: calc(var(--cell) * 3); display: flex; align-items: center; padding: 0 calc(var(--cell) * 4); background: var(--surface); border-bottom: 1px solid var(--line); }
  .logo { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 800; font-size: 18px; color: var(--ink); text-decoration: none; letter-spacing: -.01em; }
  .logo-mark { width: 24px; height: 24px; background: var(--brand); color: var(--on-brand); display: grid; place-items: center; font-size: 12px; }

  /* Contenu : calé sur la grille (marges en nombre de cases) */
  main { flex: 1; padding: calc(var(--cell) * 3) calc(var(--cell) * 4); display: grid; grid-template-columns: auto 1fr; gap: calc(var(--cell) * 3); align-items: start; align-content: center; }

  .copy { max-width: 44ch; padding-top: var(--cell); }
  .code { font-size: 14px; font-weight: 700; color: var(--ink-muted); }
  h1 { margin: var(--space-2) 0 var(--space-4); font-size: 48px; line-height: 52px; font-weight: 800; letter-spacing: -.02em; }
  p { margin: 0 0 var(--space-4); font-size: 18px; line-height: 28px; }
  .path { display: inline-block; margin: 0 0 var(--space-4); font: 400 14px/20px var(--font-mono); color: var(--ink-muted); background: var(--surface); border: 1px solid var(--line); padding: 4px 10px; max-width: 100%; overflow-wrap: anywhere; }
  .path[hidden] { display: none; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-6); }
  .btn {
    display: inline-flex; align-items: center; gap: var(--space-2); white-space: nowrap; cursor: pointer;
    font: 700 15px/20px var(--font-sans); padding: 12px 18px; border-radius: var(--radius-sm); text-decoration: none;
    background: var(--brand); color: var(--on-brand); border: 1px solid var(--brand); transition: background-color .15s;
  }
  .btn:hover { background: var(--brand-hover); }
  .btn.ghost { background: var(--surface); color: var(--ink); border-color: var(--ink-muted); }
  .btn.ghost:hover { border-color: var(--ink); background: var(--surface); }
  .btn svg { width: 18px; height: 18px; }

  footer { display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; padding: var(--space-4) calc(var(--cell) * 4); font-size: 14px; color: var(--ink-muted); background: var(--surface); border-top: 1px solid var(--line); }
  footer a { color: var(--ink-muted); }

  @media (max-width: 900px) {
    main { grid-template-columns: 1fr; gap: calc(var(--cell) * 2); }
    .copy { padding-top: 0; }
  }
  @media (max-width: 560px) {
    .top, footer { padding-left: 16px; padding-right: 16px; }
    main { padding: calc(var(--cell) * 3) 16px calc(var(--cell) * 2); }
    h1 { font-size: 36px; line-height: 40px; }
    p { font-size: 17px; line-height: 26px; }
  }
</style>

<script>
  // 404 : affiche l'adresse demandée
  const path = document.querySelector<HTMLElement>('[data-path]');
  if (path) {
    let requested = location.pathname + location.search;
    try { requested = decodeURIComponent(requested); } catch { /* adresse mal encodée : on l'affiche telle quelle */ }
    if (requested !== '/' && !requested.endsWith('.html')) {
      path.textContent = requested;
      path.hidden = false;
    }
  }

  // Bouton « Réessayer »
  document.querySelector('[data-retry]')?.addEventListener('click', () => location.reload());
</script>
