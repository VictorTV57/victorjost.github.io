---
import { getCollection } from 'astro:content';
import Contact from '../components/Contact.astro';
import Hackathons from '../components/Hackathons.astro';
import Perso from '../components/Perso.astro';
import ProjectCategory from '../components/ProjectCategory.astro';
import Sidebar from '../components/Sidebar.astro';
import Skills from '../components/Skills.astro';
import Timeline from '../components/Timeline.astro';
import { experience, formation } from '../data/parcours';
import Base from '../layouts/Base.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;

const projects = (await getCollection('projects')).sort(byOrder);
const categories = [
  { id: 'epitech', title: 'Projets EPITECH' },
  { id: 'perso', title: 'Projets perso' },
  { id: 'entreprise', title: 'En entreprise' },
].map((cat) => ({ ...cat, projects: projects.filter((p) => p.data.category === cat.id) }));

const hackathons = (await getCollection('hackathons')).sort(byOrder);
---
<Base>
  <div class="layout">
    <Sidebar />

    <main class="content">
      <div class="content-inner">
        <section id="a-propos">
          <h2>À propos</h2>
          <div class="prose reveal">
            <p>Tout a commencé très jeune, manette en main. À force de jouer, je me suis demandé ce qui se passait derrière l'écran : comment fonctionne un ordinateur, comment un programme prend vie. Cette curiosité ne m'a pas quitté.</p>
            <p>Aujourd'hui je suis en 3e année à EPITECH Nancy, avec un profil de développeur généraliste : du C# et .NET en entreprise, du Python sur une voiture autonome, du TypeScript pour le web, et Imperium, une suite de systèmes de jeu que je porte sur une douzaine de moteurs et de langages. J'ai aussi fait un stage de 4 mois chez ONYX Informatique, à Yutz, et je m'occupe d'EpiClutch, l'association jeu vidéo de l'école.</p>
            <p>Loin du clavier, je marche, je randonne avec les Scouts Unitaires de France, je fais du vélo, et chaque mardi soir je cours avec le BlaBlaRunClub à Nancy.</p>
          </div>
        </section>

        <section id="projets">
          <h2>Projets</h2>
          {categories.map((cat) => <ProjectCategory title={cat.title} projects={cat.projects} />)}
        </section>

        <section id="hackathons">
          <h2>Hackathons</h2>
          <p class="muted section-intro">Coder contre la montre, en équipe.</p>
          <Hackathons items={hackathons} />
        </section>

        <section id="contact">
          <Contact />
        </section>

        <section id="experience">
          <h2>Expérience professionnelle et autres</h2>
          <Timeline items={experience} />
        </section>

        <section id="formation">
          <h2>Formation</h2>
          <Timeline items={formation} />
        </section>

        <section id="competences">
          <h2>Compétences</h2>
          <Skills />
        </section>

        <section id="perso">
          <h2>En dehors du code</h2>
          <p class="muted section-intro">Ce qui tourne sur mon écran et dans mes écouteurs quand je ne code pas.</p>
          <Perso />
        </section>

        <footer>© {new Date().getFullYear()} Victor Jost · Site statique Astro, hébergé sur GitHub Pages</footer>
      </div>
    </main>
  </div>
</Base>
