---
import DetailHeader from '../components/DetailHeader.astro';
import type { Step } from '../data/parcours';
import { tr, type Lang } from '../i18n';
import { href } from '../i18n/routes';
import { useUi } from '../i18n/ui';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  lang: Lang;
  step: Step;
}

const { lang, step } = Astro.props;
const ui = useUi(lang);
const kind = step.kind === 'experience' ? ui.journey.experience : ui.journey.formation;
---
<SiteLayout lang={lang} route={{ section: 'journey', id: step.id }} title={tr(step.title, lang)} description={tr(step.text, lang)} active={step.kind}>
  <section>
    <DetailHeader back={{ href: href(lang, 'journey'), label: ui.journey.back }} kicker={`${kind} · ${tr(step.when, lang)}`} title={tr(step.title, lang)}>
      <p>{tr(step.text, lang)}</p>
      {step.details && <ul class="details">{step.details.map((d) => <li>{tr(d, lang)}</li>)}</ul>}
      {step.now && <span class="status">{ui.journey.now}</span>}
    </DetailHeader>
  </section>
</SiteLayout>

<style>
  .details { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .details li { display: flex; align-items: baseline; gap: var(--space-4); }
  .details li::before { content: ""; width: 8px; height: 8px; background: var(--brand); flex-shrink: 0; transform: translateY(-2px); }
</style>
