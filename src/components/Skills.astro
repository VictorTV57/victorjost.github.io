---
import { languages, notions, spoken, tools } from '../data/skills';
import { tr, type Lang } from '../i18n';
import { useUi } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = useUi(lang);
---
<div class="skills reveal">
  <div class="skill-box">
    <h3>{ui.skills.languages}</h3>
    <ul class="tags">{languages.map((s) => <li>{s}</li>)}</ul>
    <h4>{ui.skills.notions}</h4>
    <ul class="tags">{notions.map((s) => <li>{s}</li>)}</ul>
  </div>
  <div class="skill-box">
    <h3>{ui.skills.tools}</h3>
    <ul class="tags">{tools.map((s) => <li>{s}</li>)}</ul>
  </div>
  <div class="skill-box langs">
    <h3>{ui.skills.spoken}</h3>
    <dl>
      {spoken.map((s) => (
        <div>
          <dt>{tr(s.name, lang)}</dt>
          <dd>{tr(s.level, lang)}{s.note && <> <span class="muted">{tr(s.note, lang)}</span></>}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  .skills { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .skill-box { background: var(--surface); border: 1px solid var(--line); padding: var(--space-6); }
  h3 { margin: 0 0 var(--space-4); font-size: 16px; }
  h4 { margin: var(--space-4) 0 var(--space-2); font-size: 13px; color: var(--ink-muted); font-weight: 700; }
  .langs { grid-column: 1 / -1; }
  dl { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  dt { font-weight: 700; }
  dd { margin: 2px 0 0; color: var(--ink); }
  @media (max-width: 760px) { dl { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .skills { grid-template-columns: 1fr; } }
</style>
