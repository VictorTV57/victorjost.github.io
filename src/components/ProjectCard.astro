---
import type { CollectionEntry } from 'astro:content';
import { tr, type Lang } from '../i18n';
import { href } from '../i18n/routes';
import { useUi } from '../i18n/ui';
import { projectExtras } from './project-extras';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  reveal?: boolean;
}

const { lang, project, reveal = false } = Astro.props;
const ui = useUi(lang);
const { title, kind, summary, thumb, tags, status } = project.data;
const link = href(lang, 'projects', project.id);
const Extra = projectExtras[project.id];
---
<article class:list={['project', { reveal }]}>
  <div class="thumb" aria-hidden="true">
    <img src={thumb.src} width={thumb.width} height={thumb.height} alt="" loading="lazy" decoding="async" />
  </div>
  <div>
    <h3><a href={link}>{tr(title, lang)}</a></h3>
    <div class="kind">{tr(kind, lang)}</div>
    <p>{tr(summary, lang)}</p>
    {status && <span class="status">{tr(status, lang)}</span>}
    <div class="meta">
      <ul class="tags">{tags.map((tag) => <li>{tr(tag, lang)}</li>)}</ul>
      <a class="code-link" href={link} aria-hidden="true" tabindex="-1">{ui.projects.seeProject}<svg aria-hidden="true"><use href="#arrow" /></svg></a>
    </div>
  </div>
  {Extra && <Extra lang={lang} />}
</article>

<style>
  .project {
    display: grid; grid-template-columns: 96px 1fr; gap: var(--space-6);
    background: var(--surface); border: 1px solid var(--line); padding: var(--space-6);
    transition: border-color .15s;
  }
  .project + .project { margin-top: var(--space-4); }
  .project:hover { border-color: var(--ink-muted); }
  .thumb { width: 96px; height: 96px; border: 1px solid var(--line); overflow: hidden; }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  h3 { margin: 0; font-size: 20px; line-height: 26px; font-weight: 700; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .kind { font-size: 14px; color: var(--ink-muted); margin-top: 2px; }
  p { margin: var(--space-2) 0 0; }
  .meta { margin-top: var(--space-4); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .code-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 14px; text-decoration: none; color: var(--brand); white-space: nowrap; }
  .code-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .code-link svg { width: 14px; height: 14px; }

  @media (max-width: 560px) {
    .project { grid-template-columns: 1fr; gap: var(--space-4); }
    .thumb { width: 100%; height: 120px; }
  }
</style>
