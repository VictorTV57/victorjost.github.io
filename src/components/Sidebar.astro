---
import { site } from '../data/site';

const toc = [
  { id: 'a-propos', label: 'À propos' },
  { id: 'projets', label: 'Projets' },
  { id: 'hackathons', label: 'Hackathons' },
  { id: 'contact', label: 'Contact' },
  { id: 'experience', label: 'Expérience' },
  { id: 'formation', label: 'Formation' },
  { id: 'competences', label: 'Compétences' },
  { id: 'perso', label: 'En dehors du code' },
];
---
<aside class="side">
  <div class="side-inner">
    <div class="monogram in" style="--i:0" aria-hidden="true">VJ</div>
    <h1 class="in" style="--i:1">Victor<span>Jost</span></h1>
    <p class="pitch in" style="--i:2">{site.pitch}</p>
    <span class="badge in" style="--i:3"><span class="dot" aria-hidden="true"></span>{site.availability}</span>
    <div class="actions in" style="--i:4">
      <a class="btn" href={site.github} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#gh" /></svg>Voir mon GitHub</a>
      <a class="btn ghost" href="#contact">Me contacter</a>
    </div>

    <nav class="toc in" style="--i:5" aria-label="Sommaire">
      <ol>
        {toc.map(({ id, label }) => <li><a href={`#${id}`} data-nav>{label}</a></li>)}
      </ol>
    </nav>

    <div class="socials in" style="--i:6">
      <a href={site.github} target="_blank" rel="noopener" aria-label="GitHub"><svg aria-hidden="true"><use href="#gh" /></svg></a>
      <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg aria-hidden="true"><use href="#in" /></svg></a>
      <a href={`mailto:${site.email}`} aria-label="E-mail"><svg aria-hidden="true"><use href="#mail" /></svg></a>
    </div>
  </div>
</aside>

<style>
  .side { background: var(--ink); color: var(--surface); }
  .side :focus-visible { outline-color: var(--brand-light); }
  .side-inner {
    position: sticky; top: 0; height: 100vh; padding: 72px 48px 48px;
    display: flex; flex-direction: column;
    max-width: 520px; margin-left: auto;
  }
  .monogram { width: 48px; height: 48px; background: var(--brand); color: var(--on-brand); display: grid; place-items: center; font-weight: 800; font-size: 18px; }
  h1 { margin: var(--space-6) 0 0; font-size: 64px; line-height: .95; font-weight: 800; letter-spacing: -.03em; }
  h1 span { display: block; color: var(--brand-light); }
  .pitch { margin: var(--space-4) 0 0; max-width: 36ch; color: var(--ink-text); font-size: 17px; line-height: 26px; }
  .badge { margin-top: var(--space-6); display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; font-size: 14px; font-weight: 500; color: var(--surface); border: 1px solid var(--ink-line); padding: 6px 12px; border-radius: var(--radius-sm); }
  .dot { position: relative; width: 8px; height: 8px; background: var(--accent); }
  .dot::after { content: ""; position: absolute; inset: 0; background: var(--accent); animation: ping 1.6s cubic-bezier(0, 0, .2, 1) infinite; }
  @keyframes ping { 75%, 100% { transform: scale(2.4); opacity: 0; } }

  /* Sommaire avec section active */
  .toc { margin-top: var(--space-12); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .toc a { display: flex; align-items: center; gap: var(--space-4); padding: 6px 0; color: var(--ink-soft); text-decoration: none; font-size: 14px; font-weight: 500; }
  .toc a::before { content: ""; width: 24px; height: 1px; background: var(--ink-soft); transition: width .25s, background-color .25s; }
  .toc a:hover, .toc a.current { color: var(--surface); }
  .toc a.current::before { width: 72px; height: 2px; background: var(--accent); }

  .socials { margin-top: auto; padding-top: var(--space-6); display: flex; gap: var(--space-4); border-top: 1px solid var(--ink-line); }
  .socials a { color: var(--ink-text); display: inline-flex; }
  .socials a:hover { color: var(--surface); }
  .socials svg { width: 22px; height: 22px; }

  @media (max-width: 960px) {
    .side-inner { position: static; height: auto; max-width: none; margin: 0; padding: 48px 24px; }
    h1 { font-size: 52px; }
    .toc { display: none; }
    .socials { margin-top: var(--space-6); }
  }
  @media (max-width: 560px) {
    .side-inner { padding-left: 16px; padding-right: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot::after { animation: none; }
  }
</style>

<script>
  // Sommaire : la section visible s'allume
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((s): s is HTMLElement => s !== null);

  function updateToc() {
    if (!sections.length) return;
    let current = sections[0];
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) current = sections[sections.length - 1];
    else for (const s of sections) if (s.getBoundingClientRect().top < innerHeight * 0.35) current = s;
    for (const link of links) link.classList.toggle('current', link.hash === `#${current.id}`);
  }

  addEventListener('scroll', updateToc, { passive: true });
  addEventListener('resize', updateToc);
  updateToc();
</script>
