---
import { site } from '../data/site';
import { otherLang, type Lang } from '../i18n';
import { href, type Section } from '../i18n/routes';
import { useUi } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Section affichée, allumée dans le menu. */
  current: Section;
  /** Adresse de la page courante dans l'autre langue. */
  alternate: string;
}

const { lang, current, alternate } = Astro.props;
const ui = useUi(lang);
const other = otherLang(lang);
const nav: Section[] = ['home', 'projects', 'hackathons', 'journey', 'skills', 'beyond'];
// Le nom est le titre de l'accueil ; sur les autres pages, le titre est celui de la page
const Name = current === 'home' ? 'h1' : 'p';
---
<aside class="side">
  <div class="side-inner">
    <div class="side-top in" style="--i:0">
      <a class="monogram" href={href(lang, 'home')} aria-label={ui.nav.home}>VJ</a>
      <a class="lang" href={alternate} hreflang={other} lang={other} aria-label={ui.switchToAria}>{ui.switchTo}</a>
    </div>
    <Name class="name in" style="--i:1">Victor<span>Jost</span></Name>
    <p class="pitch in" style="--i:2">{site.pitch[lang]}</p>
    <span class="badge in" style="--i:3"><span class="dot" aria-hidden="true"></span>{site.availability[lang]}</span>
    <div class="actions in" style="--i:4">
      <a class="btn" href={site.github} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#gh" /></svg>{ui.githubCta}</a>
      <a class="btn ghost" href="#contact">{ui.contactCta}</a>
    </div>

    <nav class="toc in" style="--i:5" aria-label={ui.nav.label}>
      <ol>
        {nav.map((section) => (
          <li><a href={href(lang, section)} aria-current={section === current ? 'page' : undefined}>{ui.nav[section]}</a></li>
        ))}
        <li><a href="#contact">{ui.nav.contact}</a></li>
      </ol>
    </nav>

    <div class="socials in" style="--i:6">
      <a href={site.github} target="_blank" rel="noopener" aria-label="GitHub"><svg aria-hidden="true"><use href="#gh" /></svg></a>
      <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg aria-hidden="true"><use href="#in" /></svg></a>
      <a href={`mailto:${site.email}`} aria-label="E-mail"><svg aria-hidden="true"><use href="#mail" /></svg></a>
    </div>
  </div>
</aside>

<style>
  .side { background: var(--ink); color: var(--surface); }
  .side :focus-visible { outline-color: var(--brand-light); }
  .side-inner {
    position: sticky; top: 0; height: 100vh; overflow-y: auto; padding: 72px 48px 48px;
    display: flex; flex-direction: column;
    max-width: 520px; margin-left: auto;
  }
  .side-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .monogram { width: 48px; height: 48px; background: var(--brand); color: var(--on-brand); display: grid; place-items: center; font-weight: 800; font-size: 18px; text-decoration: none; }
  .lang { font-size: 13px; font-weight: 700; color: var(--ink-text); text-decoration: none; border: 1px solid var(--ink-line); border-radius: var(--radius-sm); padding: 4px 10px; }
  .lang:hover { color: var(--surface); border-color: var(--ink-soft); }
  .name { margin: var(--space-6) 0 0; font-size: 64px; line-height: .95; font-weight: 800; letter-spacing: -.03em; }
  .name span { display: block; color: var(--brand-light); }
  .pitch { margin: var(--space-4) 0 0; max-width: 36ch; color: var(--ink-text); font-size: 17px; line-height: 26px; }
  .badge { margin-top: var(--space-6); display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; font-size: 14px; font-weight: 500; color: var(--surface); border: 1px solid var(--ink-line); padding: 6px 12px; border-radius: var(--radius-sm); }
  .dot { position: relative; width: 8px; height: 8px; background: var(--accent); }
  .dot::after { content: ""; position: absolute; inset: 0; background: var(--accent); animation: ping 1.6s cubic-bezier(0, 0, .2, 1) infinite; }
  @keyframes ping { 75%, 100% { transform: scale(2.4); opacity: 0; } }

  /* Menu du site, la page courante est allumée */
  .toc { margin-top: var(--space-12); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .toc a { display: flex; align-items: center; gap: var(--space-4); padding: 6px 0; color: var(--ink-soft); text-decoration: none; font-size: 14px; font-weight: 500; }
  .toc a::before { content: ""; width: 24px; height: 1px; background: var(--ink-soft); transition: width .25s, background-color .25s; }
  .toc a:hover, .toc a[aria-current="page"] { color: var(--surface); }
  .toc a[aria-current="page"]::before { width: 72px; height: 2px; background: var(--accent); }

  .socials { margin-top: auto; padding-top: var(--space-6); display: flex; gap: var(--space-4); border-top: 1px solid var(--ink-line); }
  .socials a { color: var(--ink-text); display: inline-flex; }
  .socials a:hover { color: var(--surface); }
  .socials svg { width: 22px; height: 22px; }

  @media (max-width: 960px) {
    .side-inner { position: static; height: auto; overflow: visible; max-width: none; margin: 0; padding: 48px 24px; }
    .name { font-size: 52px; }
    .toc { margin-top: var(--space-6); }
    .toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-4); }
    .toc a::before { width: 12px; }
    .toc a[aria-current="page"]::before { width: 24px; }
    .socials { margin-top: var(--space-6); }
  }
  @media (max-width: 560px) {
    .side-inner { padding-left: 16px; padding-right: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot::after { animation: none; }
  }
</style>
