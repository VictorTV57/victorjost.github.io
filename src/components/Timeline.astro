---
import type { Step } from '../data/parcours';
import { tr, type Lang } from '../i18n';
import { href } from '../i18n/routes';

interface Props {
  lang: Lang;
  items: Step[];
}

const { lang, items } = Astro.props;
---
<ol class="timeline">
  {items.map((step) => (
    <li class:list={['reveal', { now: step.now }]}>
      <span class="when">{tr(step.when, lang)}</span>
      <h3><a href={href(lang, 'journey', step.id)}>{tr(step.title, lang)}</a></h3>
      <p>{tr(step.text, lang)}</p>
      {step.details && <ul class="details">{step.details.map((d) => <li>{tr(d, lang)}</li>)}</ul>}
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .timeline > li { position: relative; padding: 0 0 var(--space-6) 40px; }
  .timeline > li:last-child { padding-bottom: 0; }
  .timeline > li::before { content: ""; position: absolute; left: 0; top: 6px; width: 12px; height: 12px; background: var(--surface); border: 2px solid var(--brand); }
  .timeline > li.now::before { background: var(--brand); }
  /* Points clés : petits carrés, comme les repères de la frise */
  .details { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: grid; gap: 2px; font-size: 14px; color: var(--ink-muted); }
  .details li { display: flex; align-items: baseline; gap: var(--space-2); }
  .details li::before { content: ""; width: 6px; height: 6px; background: var(--ink-muted); flex-shrink: 0; transform: translateY(-2px); }
  .when { font-size: 14px; font-weight: 700; color: var(--ink-muted); }
  h3 { margin: 2px 0 0; font-size: 18px; line-height: 24px; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  p { margin: 4px 0 0; color: var(--ink-muted); }
</style>
