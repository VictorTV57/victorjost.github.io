---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
  title: string;
  /** Déjà triés par `order`. */
  projects: CollectionEntry<'projects'>[];
}

const { lang, title, projects } = Astro.props;
---
{projects.length > 0 && (
  <div class="cat">
    <h3 class="cat-title">{title}</h3>
    {projects.map((project) => <ProjectCard lang={lang} project={project} reveal />)}
  </div>
)}

<style>
  .cat { margin-bottom: var(--space-12); }
  .cat:last-child { margin-bottom: 0; }
</style>
